# Android release signing — COPY this file to `keystore.properties` (same folder)
# and fill in your real values. `keystore.properties` and the .keystore file are
# GITIGNORED — never commit them, never paste their values into chat.
#
# Generate the upload keystore once (see SIGNING below), then fill these in.
#
# storeFile is relative to the android/ folder (so put the .keystore in android/).
storeFile=globeskimmers-upload.keystore
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=globeskimmers
keyPassword=YOUR_KEY_PASSWORD
